<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SHAHRIAR — مركز الرجال الفاخر</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300&family=Amiri:wght@400;700&family=Cinzel:wght@400;600&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box}
:root{
  --m:#3d0a14;--m2:#4e0f1a;--m3:#5c1220;--md:#280610;
  --g:#c9922a;--gl:#d4a843;--gp:#e8cc80;--gb:#f0d878;
  --tg:#d4a843;--tl:#f5e6c4;--td:#c9a87a;
}
html{scroll-behavior:smooth}
body{background:var(--md);color:var(--tl);font-family:'Amiri',serif;min-height:100vh;overflow-x:hidden}

/* SPLASH */
#splash{position:fixed;inset:0;z-index:9999;background:radial-gradient(ellipse 80% 80% at 50% 50%,#1a0208,#0a0104);
  display:flex;flex-direction:column;align-items:center;justify-content:center;overflow:hidden;
  transition:opacity 1s ease,visibility 1s ease}
#splash.hide{opacity:0;visibility:hidden;pointer-events:none}
.sp-ring{position:absolute;border-radius:50%;border:1px solid rgba(201,146,42,.1);animation:ring 4s ease-out infinite}
@keyframes ring{0%{transform:scale(.2);opacity:.6}100%{transform:scale(3.2);opacity:0}}
.sp-dot{position:absolute;border-radius:50%;background:var(--g);opacity:0;animation:sdot linear infinite}
@keyframes sdot{0%{transform:translateY(100vh);opacity:0}10%{opacity:.5}90%{opacity:.1}100%{transform:translateY(-10vh);opacity:0}}
.sp-wrap{display:flex;flex-direction:column;align-items:center;gap:20px;
  animation:srise 1.3s cubic-bezier(.16,1,.3,1) .2s both}
@keyframes srise{from{transform:translateY(50px) scale(.85);opacity:0;filter:blur(12px)}to{transform:none;opacity:1;filter:none}}

/* Watermark logo for splash — SVG filter approach */
.sp-logo{width:200px;height:200px;object-fit:contain;
  filter:drop-shadow(0 0 45px rgba(201,146,42,.8)) drop-shadow(0 0 90px rgba(201,146,42,.35)) brightness(1.1) saturate(1.2);
  animation:lglow 3s ease-in-out 1.5s infinite}
@keyframes lglow{
  0%,100%{filter:drop-shadow(0 0 35px rgba(201,146,42,.7)) drop-shadow(0 0 70px rgba(201,146,42,.3)) brightness(1.05) saturate(1.1)}
  50%{filter:drop-shadow(0 0 60px rgba(230,180,60,.95)) drop-shadow(0 0 120px rgba(201,146,42,.5)) brightness(1.15) saturate(1.3)}
}
.sp-brand{font-family:'Cinzel',serif;font-size:clamp(28px,6vw,60px);letter-spacing:.4em;
  background:linear-gradient(175deg,var(--gb) 0%,var(--gl) 35%,var(--g) 65%,#8b4010 100%);
  -webkit-background-clip:text;background-clip:text;color:transparent;
  animation:srise 1.3s cubic-bezier(.16,1,.3,1) .5s both}
.sp-div{display:flex;align-items:center;gap:14px;animation:srise 1.3s cubic-bezier(.16,1,.3,1) .7s both}
.sp-line{width:65px;height:1px;background:linear-gradient(90deg,transparent,var(--g),transparent)}
.sp-diamond{width:6px;height:6px;background:var(--g);transform:rotate(45deg);box-shadow:0 0 10px rgba(201,146,42,.9)}
.sp-tag{font-family:'Cormorant Garamond',serif;font-style:italic;font-size:clamp(11px,1.6vw,15px);
  color:var(--tg);opacity:.72;text-align:center;
  animation:srise 1.3s cubic-bezier(.16,1,.3,1) .9s both}
.sp-bar{position:absolute;bottom:0;left:0;height:1px;
  background:linear-gradient(90deg,transparent,var(--g),transparent);
  animation:sbar 3.4s ease .7s forwards;width:0}
@keyframes sbar{to{width:100%}}

/* LANG SWITCHER */
#ls{position:fixed;top:18px;right:18px;z-index:9000;
  display:flex;background:rgba(20,4,8,.8);border:1px solid rgba(201,146,42,.2);
  border-radius:3px;backdrop-filter:blur(10px);overflow:hidden}
.lb{background:none;border:none;color:rgba(212,168,67,.5);font-family:'Cinzel',serif;
  font-size:10px;letter-spacing:.2em;padding:9px 15px;cursor:pointer;transition:all .25s;position:relative}
.lb:first-child{border-right:1px solid rgba(201,146,42,.12)}
.lb:hover{color:var(--gl);background:rgba(201,146,42,.06)}
.lb.on{color:var(--g);background:rgba(201,146,42,.1)}
.lb.on::after{content:'';position:absolute;bottom:0;left:0;right:0;height:1px;background:var(--g)}

/* ADMIN BTN */
#ab{position:fixed;top:18px;left:18px;z-index:9000;background:rgba(61,10,20,.45);
  border:1px solid rgba(201,146,42,.12);color:rgba(201,146,42,.18);
  width:32px;height:32px;border-radius:3px;display:flex;align-items:center;justify-content:center;
  cursor:pointer;transition:all .3s;font-size:14px}
#ab:hover{color:var(--g);border-color:rgba(201,146,42,.35);background:rgba(201,146,42,.07)}

/* LOGIN */
#lo{display:none;position:fixed;inset:0;background:rgba(0,0,0,.92);z-index:10000;
  align-items:center;justify-content:center;backdrop-filter:blur(6px)}
#lo.on{display:flex}
.lb-box{background:linear-gradient(145deg,var(--m2),var(--md));border:1px solid var(--g);
  border-radius:10px;padding:42px 36px;width:320px;text-align:center;position:relative}
.lb-logo{font-family:'Cinzel',serif;font-size:20px;color:var(--gl);letter-spacing:5px;margin-bottom:5px}
.lb-sub{font-size:12px;color:var(--tg);margin-bottom:28px;opacity:.65;letter-spacing:.05em}
.lb-box input{width:100%;background:rgba(201,146,42,.06);border:1px solid rgba(201,146,42,.25);
  border-radius:4px;padding:11px 14px;color:var(--tl);font-family:'Amiri',serif;font-size:14px;
  margin-bottom:12px;outline:none;text-align:center;direction:ltr}
.lb-box input:focus{border-color:var(--g)}
.lb-btn{width:100%;background:linear-gradient(135deg,var(--g),#8b3a1a);border:none;border-radius:4px;
  padding:12px;color:#fff;font-family:'Cinzel',serif;font-size:12px;letter-spacing:3px;cursor:pointer;transition:opacity .2s}
.lb-btn:hover{opacity:.85}
.lb-err{color:#e07070;font-size:12px;margin-top:8px;display:none}
.lb-close{position:absolute;top:12px;left:12px;background:none;border:none;
  color:rgba(201,146,42,.3);font-size:16px;cursor:pointer;transition:color .2s}
.lb-close:hover{color:var(--g)}

/* ADMIN PANEL */
#ap{display:none;position:fixed;inset:0;background:var(--md);z-index:10001;overflow-y:auto}
#ap.on{display:block}
.ap-h{background:linear-gradient(90deg,var(--m2),var(--m3));border-bottom:1px solid rgba(201,146,42,.25);
  padding:14px 24px;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:10}
.ap-t{font-family:'Cinzel',serif;color:var(--gl);font-size:15px;letter-spacing:3px}
.ap-back{background:none;border:1px solid rgba(201,146,42,.25);color:var(--tg);
  border-radius:3px;padding:7px 16px;cursor:pointer;font-family:'Amiri',serif;font-size:13px;transition:all .2s}
.ap-back:hover{border-color:var(--g);color:var(--g)}
.ap-body{padding:24px;max-width:860px;margin:0 auto}
.ap-sec{background:rgba(201,146,42,.04);border:1px solid rgba(201,146,42,.13);
  border-radius:7px;padding:20px;margin-bottom:18px}
.ap-sec h3{font-family:'Cinzel',serif;color:var(--gl);font-size:12px;letter-spacing:2px;
  margin-bottom:16px;padding-bottom:8px;border-bottom:1px solid rgba(201,146,42,.15)}
.ap-row{display:flex;gap:8px;margin-bottom:10px;align-items:center;flex-wrap:wrap}
.ap-row label{color:var(--tg);font-size:12px;min-width:110px;letter-spacing:.05em}
.ap-row input,.ap-row textarea{flex:1;min-width:180px;background:rgba(0,0,0,.28);
  border:1px solid rgba(201,146,42,.18);border-radius:3px;padding:8px 11px;
  color:var(--tl);font-family:'Amiri',serif;font-size:13px;outline:none}
.ap-row input:focus,.ap-row textarea:focus{border-color:var(--g)}
.ap-row textarea{resize:vertical;min-height:65px}
.ap-btn{background:linear-gradient(135deg,var(--g),#8b3a1a);border:none;border-radius:3px;
  padding:8px 18px;color:#fff;font-family:'Cinzel',serif;font-size:11px;letter-spacing:1px;cursor:pointer;transition:opacity .2s}
.ap-btn:hover{opacity:.83}
.ap-btn.sec{background:rgba(201,146,42,.1);border:1px solid rgba(201,146,42,.22);color:var(--tg)}
.ap-btn.del{background:linear-gradient(135deg,#8b0000,#c0392b)}
.svc-item{background:rgba(0,0,0,.2);border:1px solid rgba(201,146,42,.1);border-radius:5px;padding:12px;margin-bottom:8px}
.svc-row{display:flex;gap:7px;align-items:center;flex-wrap:wrap;margin-bottom:7px}
.svc-row input,.svc-row select{flex:1;min-width:120px;background:rgba(0,0,0,.28);
  border:1px solid rgba(201,146,42,.15);border-radius:3px;padding:6px 9px;
  color:var(--tl);font-family:'Amiri',serif;font-size:12px;outline:none}
.dbtn{background:rgba(120,0,0,.25);border:1px solid rgba(180,40,40,.2);color:#d07070;
  border-radius:3px;padding:4px 9px;cursor:pointer;font-size:11px;transition:all .2s}
.dbtn:hover{background:rgba(180,0,0,.35)}
.sw{display:flex;align-items:center;gap:7px}
.sw input[type=checkbox]{width:34px;height:18px;appearance:none;background:rgba(201,146,42,.1);
  border:1px solid rgba(201,146,42,.22);border-radius:9px;cursor:pointer;position:relative;transition:background .3s}
.sw input:checked{background:var(--g)}
.sw input::after{content:'';position:absolute;top:2px;left:2px;width:12px;height:12px;background:#fff;border-radius:50%;transition:left .3s}
.sw input:checked::after{left:18px}
.ap-saved{color:#5cba6a;font-size:11px;margin-top:6px;display:none;letter-spacing:.06em}

/* ANIMATIONS */
@keyframes rise{from{transform:translateY(32px);opacity:0}to{transform:translateY(0);opacity:1}}
@keyframes fup{from{opacity:0;transform:translateY(18px)}to{opacity:1;transform:none}}
@keyframes floatup{0%{transform:translateY(0);opacity:0}12%{opacity:.5}90%{opacity:.15}100%{transform:translateY(-110vh) scale(.2);opacity:0}}
@keyframes spulse{0%,100%{opacity:.2;height:42px}50%{opacity:.55;height:56px}}
@keyframes glowp{
  0%,100%{filter:drop-shadow(0 0 22px rgba(201,146,42,.65)) drop-shadow(0 0 55px rgba(201,146,42,.28))}
  50%{filter:drop-shadow(0 0 38px rgba(230,180,60,.9)) drop-shadow(0 0 85px rgba(201,146,42,.45))}
}
@keyframes arabr{0%{transform:rotate(0)}50%{transform:rotate(2deg) scale(1.01)}100%{transform:rotate(0)}}

/* HERO */
#hero{min-height:100vh;display:flex;flex-direction:column;align-items:center;
  justify-content:center;position:relative;overflow:hidden;padding:60px 20px 100px}
.h-bg{position:absolute;inset:0;
  background:radial-gradient(ellipse 90% 70% at 50% 35%,var(--m2) 0%,var(--md) 65%,#1a0208 100%)}
.h-arab{position:absolute;bottom:0;left:0;right:0;height:250px;overflow:hidden;
  pointer-events:none;opacity:.18;animation:arabr 8s ease-in-out infinite}
.h-arab svg{width:100%;height:100%}
.h-pts{position:absolute;inset:0;pointer-events:none;overflow:hidden}
.pt{position:absolute;width:1.5px;height:1.5px;background:var(--gp);border-radius:50%;animation:floatup linear infinite;opacity:0}

/* Watermark logo — no stretching, clean glow */
.logo-wm{
  width:180px;height:180px;
  object-fit:contain;
  position:relative;z-index:2;
  mix-blend-mode:normal;
  animation:glowp 3s ease-in-out infinite;
  animation-delay:.5s;
  /* Ensure the PNG renders cleanly without distortion */
  image-rendering:auto;
}

.h-brand{font-family:'Cinzel',serif;font-size:clamp(36px,7vw,76px);letter-spacing:.24em;
  background:linear-gradient(175deg,var(--gb) 0%,var(--gl) 35%,var(--g) 65%,#8b4010 100%);
  -webkit-background-clip:text;background-clip:text;color:transparent;
  margin-top:18px;animation:rise 1.7s cubic-bezier(.16,1,.3,1) .15s both}
.h-tag{font-family:'Cormorant Garamond',serif;font-style:italic;font-size:clamp(14px,2vw,21px);
  color:var(--tg);margin-top:12px;opacity:.8;text-align:center;max-width:520px;line-height:1.9;
  animation:rise 1.9s cubic-bezier(.16,1,.3,1) .3s both}
.scroll-h{margin-top:48px;display:flex;flex-direction:column;align-items:center;gap:7px;
  opacity:.35;animation:fup 2.2s ease-out 2s both}
.scroll-l{width:1px;height:44px;background:linear-gradient(to bottom,transparent,var(--g),transparent);animation:spulse 2.4s ease-in-out infinite}

/* ORNAMENT */
.orn{display:flex;align-items:center;gap:16px;margin:0 auto 42px;max-width:480px;padding:0 20px}
.ol{flex:1;height:1px;background:linear-gradient(90deg,transparent,var(--g),transparent)}
.og{width:8px;height:8px;background:var(--g);transform:rotate(45deg);
  box-shadow:0 0 9px rgba(201,146,42,.65),0 0 16px rgba(201,146,42,.22);position:relative}
.og::before,.og::after{content:'';position:absolute;top:50%;left:50%;
  width:14px;height:1px;background:var(--g);opacity:.3;transform:translate(-50%,-50%)}
.og::after{transform:translate(-50%,-50%) rotate(90deg)}

.divider{width:100%;height:1px;background:linear-gradient(90deg,transparent,rgba(201,146,42,.32),transparent)}
.sec{padding:76px 22px;max-width:1100px;margin:0 auto}
.sec-t{font-family:'Cinzel',serif;font-size:clamp(15px,2.5vw,23px);color:var(--gl);letter-spacing:.22em;text-align:center;margin-bottom:10px}
.sec-s{font-family:'Cormorant Garamond',serif;font-style:italic;text-align:center;color:var(--tg);opacity:.65;font-size:16px;margin-bottom:48px}

/* ABOUT */
#about-text{font-family:'Cormorant Garamond',serif;font-size:clamp(16px,2vw,21px);
  line-height:2.05;text-align:center;color:var(--tl);opacity:.88;max-width:720px;margin:0 auto}

/* SERVICES */
.sg{display:grid;grid-template-columns:repeat(auto-fit,minmax(272px,1fr));gap:18px}
.sc{background:linear-gradient(150deg,rgba(78,15,26,.65),rgba(40,6,16,.9));
  border:1px solid rgba(201,146,42,.18);border-radius:11px;overflow:hidden;cursor:pointer;
  transition:all .4s cubic-bezier(.16,1,.3,1);position:relative}
.sc::before{content:'';position:absolute;inset:0;background:linear-gradient(135deg,rgba(201,146,42,.05),transparent);opacity:0;transition:opacity .4s}
.sc:hover{border-color:rgba(201,146,42,.55);transform:translateY(-4px);box-shadow:0 14px 36px rgba(0,0,0,.36),0 0 24px rgba(201,146,42,.06)}
.sc:hover::before{opacity:1}
.sc-h{padding:22px 20px 15px;display:flex;align-items:flex-start;gap:13px;border-bottom:1px solid rgba(201,146,42,.09)}
.sc-ic{width:48px;height:48px;border-radius:9px;background:rgba(201,146,42,.07);
  border:1px solid rgba(201,146,42,.18);display:flex;align-items:center;justify-content:center;flex-shrink:0}
.sc-ic svg{width:24px;height:24px}
.sc-en{font-family:'Cinzel',serif;font-size:9px;letter-spacing:.2em;color:var(--g);margin-bottom:4px;opacity:.75}
.sc-ar{font-family:'Amiri',serif;font-size:17px;color:var(--tl);font-weight:700;line-height:1.3}
.sc-b{padding:13px 20px 18px}
.sc-d{font-family:'Amiri',serif;font-size:14px;color:var(--td);line-height:1.85;margin-bottom:10px}
.sc-li{list-style:none;margin-bottom:10px}
.sc-li li{font-family:'Amiri',serif;font-size:13px;color:var(--tg);padding:4px 0;
  border-bottom:1px solid rgba(201,146,42,.06);display:flex;align-items:center;gap:7px;opacity:.75}
.sc-li li::before{content:'◆';font-size:5px;color:var(--g);flex-shrink:0}
.sc-price{font-family:'Cinzel',serif;font-size:11px;color:var(--g);letter-spacing:1px;
  padding-top:8px;border-top:1px solid rgba(201,146,42,.13)}
.sc-arr{display:flex;align-items:center;justify-content:flex-end;gap:5px;
  font-family:'Cinzel',serif;font-size:8px;letter-spacing:.15em;color:var(--tg);
  opacity:.45;padding:0 20px 12px;transition:opacity .3s}
.sc:hover .sc-arr{opacity:.85}
.sc-arr svg{width:11px;height:11px;transition:transform .3s}
.sc.open .sc-arr svg{transform:rotate(180deg)}
.sc-exp{max-height:0;overflow:hidden;transition:max-height .5s cubic-bezier(.16,1,.3,1);border-top:1px solid rgba(201,146,42,.08)}
.sc.open .sc-exp{max-height:380px}
.sc-ei{padding:15px 20px 18px}
.sc-et{font-family:'Cinzel',serif;font-size:9px;letter-spacing:.16em;color:var(--g);margin-bottom:10px;opacity:.72}
.sc-el{list-style:none}
.sc-el li{font-family:'Amiri',serif;font-size:14px;color:var(--tl);padding:6px 0;
  border-bottom:1px solid rgba(201,146,42,.07);display:flex;justify-content:space-between;align-items:center;opacity:.85}
.sc-el li:last-child{border-bottom:none}
.sub-p{font-family:'Cinzel',serif;font-size:11px;color:var(--gl);letter-spacing:1px}

/* QUOTE */
.quote-s{position:relative;overflow:hidden;
  background:linear-gradient(135deg,var(--m2),var(--m3),var(--m2));
  border-top:1px solid rgba(201,146,42,.2);border-bottom:1px solid rgba(201,146,42,.2);
  padding:68px 22px;text-align:center}
.q-bg{position:absolute;bottom:-30px;left:50%;transform:translateX(-50%);
  font-family:'Amiri',serif;font-size:190px;color:rgba(201,146,42,.04);
  white-space:nowrap;pointer-events:none;line-height:1;user-select:none}
.q-text{font-family:'Cormorant Garamond',serif;font-style:italic;
  font-size:clamp(16px,2.5vw,24px);color:var(--tl);line-height:1.95;
  max-width:740px;margin:0 auto 18px;position:relative;z-index:1;opacity:.9}
.q-mark{font-size:50px;color:var(--g);opacity:.22;font-family:'Cinzel',serif;line-height:.5;display:block;margin-bottom:14px}
.q-by{font-family:'Cinzel',serif;font-size:10px;letter-spacing:.28em;color:var(--tg);opacity:.5;position:relative;z-index:1}

/* CALLI STRIP */
.calli{width:100%;overflow:hidden;background:var(--md);height:190px}
.calli svg{width:100%;height:100%;opacity:.15}

/* CONTACT */
.cg{display:grid;grid-template-columns:repeat(auto-fit,minmax(195px,1fr));gap:14px;margin-top:28px}
.cc{background:linear-gradient(145deg,rgba(78,15,26,.52),rgba(40,6,16,.78));
  border:1px solid rgba(201,146,42,.16);border-radius:9px;
  padding:20px 14px;text-align:center;transition:all .32s;
  text-decoration:none;display:flex;flex-direction:column;align-items:center;gap:9px}
.cc:hover{background:rgba(201,146,42,.07);border-color:rgba(201,146,42,.45);transform:translateY(-3px);box-shadow:0 9px 26px rgba(0,0,0,.26)}
.cc-ic{width:44px;height:44px;border-radius:9px;background:rgba(201,146,42,.07);
  border:1px solid rgba(201,146,42,.16);display:flex;align-items:center;justify-content:center}
.cc-ic svg{width:21px;height:21px}
.cc-l{font-family:'Cinzel',serif;font-size:9px;letter-spacing:.2em;color:var(--gl)}
.cc-v{font-family:'Amiri',serif;font-size:13px;color:var(--td);opacity:.78}

/* FOOTER */
footer{border-top:1px solid rgba(201,146,42,.13);padding:38px 18px;text-align:center}
.ft-in{display:flex;flex-direction:column;align-items:center;gap:7px}

/* Footer watermark logo */
.ft-wm{
  width:52px;height:52px;object-fit:contain;
  filter:drop-shadow(0 0 7px rgba(201,146,42,.32)) brightness(.85) saturate(1.1);
  opacity:.6;margin-bottom:5px
}
.ft-brand{font-family:'Cinzel',serif;font-size:17px;letter-spacing:.32em;color:var(--gl);opacity:.7}
.ft-copy{font-family:'Cinzel',serif;font-size:8px;color:var(--td);opacity:.3;letter-spacing:.18em;margin-top:3px}

#notif{position:fixed;bottom:22px;right:22px;background:var(--m2);border:1px solid rgba(201,146,42,.45);
  color:var(--tl);padding:11px 18px;border-radius:5px;font-family:'Cinzel',serif;font-size:11px;
  letter-spacing:.07em;display:none;z-index:20000;animation:nin .3s ease}
@keyframes nin{from{transform:translateX(90px);opacity:0}to{transform:none;opacity:1}}

html[lang=en]{direction:ltr}
.rv{opacity:0;transform:translateY(26px);transition:opacity .8s ease,transform .8s ease}
.rv.vis{opacity:1;transform:none}

@media(max-width:640px){
  .sg{grid-template-columns:1fr}
  .cg{grid-template-columns:1fr 1fr}
  #ls{top:auto;bottom:18px;right:14px}
  #ab{top:auto;bottom:18px;left:14px}
}
</style>
</head>
<body>

<!-- SPLASH -->
<div id="splash">
  <div class="sp-ring" style="width:260px;height:260px;animation-delay:0s"></div>
  <div class="sp-ring" style="width:400px;height:400px;animation-delay:1.1s"></div>
  <div class="sp-ring" style="width:540px;height:540px;animation-delay:2.2s"></div>
  <div id="sp-dots"></div>
  <div class="sp-wrap">
    <img class="sp-logo" src="LOGO_DATA_URL_PLACEHOLDER" alt="SHAHRIAR">
