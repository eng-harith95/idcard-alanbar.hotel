    const preview=s.subs.slice(0,3).map(x=>'<li>'+(en?(ENs[x]||x):x)+'</li>').join('');
    const extra=s.subs.length>3?'<li>···</li>':'';
    const full=s.subs.map(x=>{
      const n=en?(ENs[x]||x):x;
      return '<li>'+n+'</li>';
    }).join('');
    const pr=s.showP&&s.price?'<div class="sc-price">'+s.price+'</div>':'';
    const c=document.createElement('div');
    c.className='sc';
    c.innerHTML='<div class="sc-h"><div class="sc-ic">'+ic+'</div><div><div class="sc-en">'+s.en+'</div><div class="sc-ar">'+nm+'</div></div></div>'
      +'<div class="sc-b"><div class="sc-d">'+ds+'</div>'+(hs?'<ul class="sc-li">'+preview+extra+'</ul>':'')+'</div>'+pr
      +(hs?'<div class="sc-arr"><span>'+t.sd+'</span><svg viewBox="0 0 14 14" fill="none" stroke="#c9922a" stroke-width="2" stroke-linecap="round"><path d="M2 5l5 5 5-5"/></svg></div>'
          +'<div class="sc-exp"><div class="sc-ei"><div class="sc-et">'+t.sd+'</div><ul class="sc-el">'+full+'</ul></div></div>':'');
    if(hs)c.addEventListener('click',()=>c.classList.toggle('open'));
    g.appendChild(c);
  });
  const cg=document.getElementById('cg'); cg.innerHTML='';
  const t2=TR[lang]; const keys=['phone','insta','fb','tiktok'];
  const hrefs=['tel:'+d.contact.phone,d.contact.insta,d.contact.fb,d.contact.tiktok];
  const cv_custom=[d.contact.phone_v||d.contact.phone, d.contact.insta_v||'@shr1shz1', d.contact.fb_v||'Shahriar Center', d.contact.tiktok_v||'@shr1shz1'];
  keys.forEach((k,i)=>{
    const a=document.createElement('a');
    a.className='cc'; a.href=hrefs[i]; a.target='_blank'; a.rel='noopener noreferrer';
    a.innerHTML='<div class="cc-ic">'+CIC[k]+'</div><div class="cc-l">'+t2.cl[i]+'</div><div class="cc-v">'+cv_custom[i]+'</div>';
    cg.appendChild(a);
  });
}

// ── SPLASH ────────────────────────────────────────────────
function initSplash(){
  const c=document.getElementById('sp-dots');
  for(let i=0;i<18;i++){
    const p=document.createElement('div'); p.className='sp-dot';
    const s=Math.random()*2.5+.8;
    p.style.cssText='left:'+Math.random()*100+'%;width:'+s+'px;height:'+s+'px;animation-duration:'+(Math.random()*7+5)+'s;animation-delay:'+(Math.random()*3)+'s';
    c.appendChild(p);
  }
  setTimeout(()=>{
    document.getElementById('splash').classList.add('hide');
    setTimeout(()=>document.getElementById('splash').style.display='none',1100);
  },3700);
}

// ── PARTICLES ─────────────────────────────────────────────
function initPts(){
  const c=document.getElementById('pts');
  for(let i=0;i<26;i++){
    const p=document.createElement('div'); p.className='pt';
    const s=Math.random()*2+.4;
    p.style.cssText='left:'+Math.random()*100+'%;bottom:'+Math.random()*25+'%;width:'+s+'px;height:'+s+'px;animation-duration:'+(Math.random()*9+6)+'s;animation-delay:'+(Math.random()*10)+'s;opacity:0';
    c.appendChild(p);
  }
}

// ── REVEAL ────────────────────────────────────────────────
function initReveal(){
  const obs=new IntersectionObserver(entries=>entries.forEach(e=>{if(e.isIntersecting)e.target.classList.add('vis');}),{threshold:.1});
  document.querySelectorAll('.rv').forEach(el=>obs.observe(el));
}

// ── LOGIN/ADMIN ────────────────────────────────────────────
function openLogin(){document.getElementById('lo').classList.add('on');setTimeout(()=>document.getElementById('lu').focus(),200);}
function closeLogin(){document.getElementById('lo').classList.remove('on');document.getElementById('le').style.display='none';document.getElementById('lu').value='';document.getElementById('lp').value='';}
function doLogin(){
  const u=document.getElementById('lu').value.trim(),p=document.getElementById('lp').value,d=ld();
  if(u==='admin'&&p===d.password){closeLogin();openAdmin();}
  else document.getElementById('le').style.display='block';
}
document.getElementById('lp').addEventListener('keydown',e=>{if(e.key==='Enter')doLogin();});

function openAdmin(){
  const d=ld();
  document.getElementById('ap').classList.add('on');
  document.getElementById('ap-about').value=d.about;
  document.getElementById('ap-about-en').value=d.about_en||DD.about_en;
  document.getElementById('ap-tag').value=d.tagline;
  document.getElementById('ap-ph').value=d.contact.phone;
  document.getElementById('ap-ph-v').value=d.contact.phone_v||d.contact.phone;
  document.getElementById('ap-ig').value=d.contact.insta;
  document.getElementById('ap-ig-v').value=d.contact.insta_v||'@shr1shz1';
  document.getElementById('ap-fb').value=d.contact.fb;
  document.getElementById('ap-fb-v').value=d.contact.fb_v||'Shahriar Center';
  document.getElementById('ap-tt').value=d.contact.tiktok;
  document.getElementById('ap-tt-v').value=d.contact.tiktok_v||'@shr1shz1';
  renderAdmin();
}
function closeAdmin(){document.getElementById('ap').classList.remove('on');render();}
function logOut(){closeAdmin();}

function renderAdmin(){
  const d=ld(); const list=document.getElementById('ap-svcs'); list.innerHTML='';
  d.services.forEach((s,i)=>{
    const rows=s.subs.map((sub,j)=>'<div class="svc-row"><input type="text" value="'+sub+'" data-i="'+i+'" data-j="'+j+'" data-f="sub"><button class="dbtn" onclick="delSub('+i+','+j+')">✕</button></div>').join('');
    const div=document.createElement('div'); div.className='svc-item';
    div.innerHTML='<div class="svc-row"><input value="'+s.en+'" placeholder="EN" data-i="'+i+'" data-f="en"><input value="'+s.ar+'" placeholder="AR" data-i="'+i+'" data-f="ar"><button class="dbtn" onclick="delSvc('+i+')">Del</button></div>'
      +'<div class="svc-row"><input value="'+s.d+'" placeholder="Description" data-i="'+i+'" data-f="d" style="flex:1"></div>'
      +'<div style="font-size:10px;color:#d4a843;margin-bottom:6px;letter-spacing:.08em;opacity:.7">SERVICES</div>'
      +rows
      +'<div class="svc-row" style="margin-top:6px"><button class="ap-btn sec" style="font-size:10px;padding:4px 10px" onclick="addSub('+i+')">+ Service</button>'
      +'<div class="sw"><span style="font-size:10px;color:#d4a843;letter-spacing:.07em">PRICES</span>'
      +'<input type="checkbox" '+(s.showP?'checked':'')+' data-i="'+i+'" data-f="showP"></div></div>';
    list.appendChild(div);
  });
  list.querySelectorAll('[data-f]').forEach(inp=>{
    const ev=inp.type==='checkbox'?'change':'input';
    inp.addEventListener(ev,e=>{
      const d2=ld(),idx=+e.target.dataset.i,f=e.target.dataset.f;
      if(f==='sub'){const j=+e.target.dataset.j;d2.services[idx].subs[j]=e.target.value;}
      else if(f==='showP')d2.services[idx].showP=e.target.checked;
      else d2.services[idx][f]=e.target.value;
      sd(d2);
    });
  });
}

function addSvc(){const d=ld();d.services.push({ik:'default',en:'NEW SERVICE',ar:'خدمة جديدة',d:'Description',subs:['Service'],showP:false,price:''});sd(d);renderAdmin();}
function delSvc(i){if(!confirm('Delete?'))return;const d=ld();d.services.splice(i,1);sd(d);renderAdmin();}
function addSub(i){const d=ld();d.services[i].subs.push('New Service');sd(d);renderAdmin();}
function delSub(i,j){const d=ld();d.services[i].subs.splice(j,1);sd(d);renderAdmin();}
function saveAbout(){const d=ld();d.about=document.getElementById('ap-about').value;d.about_en=document.getElementById('ap-about-en').value;sd(d);sv('sv-about');}
function saveTag(){const d=ld();d.tagline=document.getElementById('ap-tag').value;sd(d);sv('sv-tag');}
function saveCon(){const d=ld();
  d.contact.phone=document.getElementById('ap-ph').value;
  d.contact.phone_v=document.getElementById('ap-ph-v').value;
  d.contact.insta=document.getElementById('ap-ig').value;
  d.contact.insta_v=document.getElementById('ap-ig-v').value;
  d.contact.fb=document.getElementById('ap-fb').value;
  d.contact.fb_v=document.getElementById('ap-fb-v').value;
  d.contact.tiktok=document.getElementById('ap-tt').value;
  d.contact.tiktok_v=document.getElementById('ap-tt-v').value;
  sd(d);sv('sv-con');}
function saveSvcs(){sv('sv-svcs');}
function chPass(){
  const np=document.getElementById('ap-np').value,cp=document.getElementById('ap-cp').value;
  if(!np)return notif('Enter new password');
  if(np!==cp)return notif('Passwords do not match');
  const d=ld();d.password=np;sd(d);
  document.getElementById('ap-np').value='';document.getElementById('ap-cp').value='';sv('sv-pass');
}
function sv(id){const e=document.getElementById(id);e.style.display='block';setTimeout(()=>e.style.display='none',2400);}
function notif(m){const n=document.getElementById('notif');n.textContent=m;n.style.display='block';setTimeout(()=>n.style.display='none',2800);}


// Set logos
function setLogos(){
  document.querySelectorAll('img[src="LOGO_DATA_URL_PLACEHOLDER"]').forEach(img=>{img.src=LOGO_SRC;});
}
// ── INIT ──────────────────────────────────────────────────
document.addEventListener('DOMContentLoaded',()=>{
  setLogos();
  initSplash(); initPts(); setLang(lang); render(); initReveal();
});
</script>
